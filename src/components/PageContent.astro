---
import { Image } from 'astro:assets';
import lotteLab from '../assets/lotte-bjerre-knudsen-lab.webp';
import lotteGreen from '../assets/lotte-bjerre-knudsen-greenbg.webp';
import lotteGrass from '../assets/lotte-bjerre-knudsen-grass.webp';
import breakthroughPrize from '../assets/lotte-breakthrough-prize.webp';
import lottePortrait from '../assets/lotte-portrait.webp';
import lotteLaskerPrize from '../assets/lotte-lasker-prize.webp';
import lotteAmericanAcademy from '../assets/lotte-american-academy.webp';
import { content, type Locale } from '../data/content';
import Entry from './Entry.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = content[lang];
const isDa = lang === 'da';

// Hero crossfade rotation — the lab portrait loads first, then the studio
// green-wall shot, crossfading back and forth every 10 seconds.
const heroSlides = [
  {
    src: lotteLab,
    mod: 'hero__slide--lab',
    alt: isDa
      ? 'Lotte Bjerre Knudsen i laboratoriet'
      : 'Lotte Bjerre Knudsen in the laboratory',
  },
  {
    src: lotteGreen,
    mod: 'hero__slide--green',
    alt: isDa
      ? 'Lotte Bjerre Knudsen fotograferet mod en grøn baggrund'
      : 'Lotte Bjerre Knudsen photographed against a green backdrop',
  },
];

const slideWord = isDa ? 'Udsagn' : 'Statement';
const coupleAlt = isDa
  ? 'Lotte Bjerre Knudsen ved Breakthrough Prize-ceremonien'
  : 'Lotte Bjerre Knudsen at the Breakthrough Prize ceremony';
const portraitAlt = isDa
  ? 'Portræt af Lotte Bjerre Knudsen'
  : 'Portrait of Lotte Bjerre Knudsen';
const aboutAlt = isDa
  ? 'Lotte Bjerre Knudsen i lyserødt jakkesæt blandt høje græsser'
  : 'Lotte Bjerre Knudsen in a pink suit among tall grasses';
const laskerPrizeAlt = isDa
  ? 'Lotte Bjerre Knudsen ved Lasker-prisoverrækkelsen'
  : 'Lotte Bjerre Knudsen at the Lasker Award ceremony';
const americanAcademyAlt = isDa
  ? 'Lotte Bjerre Knudsen med Jimmy Page ved American Academy of Achievement'
  : 'Lotte Bjerre Knudsen with Jimmy Page at the American Academy of Achievement';

const mailto = `mailto:${c.contact.email}`;
const mailtoMentor = `${mailto}?subject=${encodeURIComponent(c.mentor.mailSubject)}`;
const awardsMediaLabel = `${c.recognition.label} & ${c.media.label}`;
---

<!-- Hero -->
<section class="hero">
  <div class="hero__inner container">
    <div class="hero__text">
      <h1 class="hero__wordmark">
        <span class="hero__line">Lotte</span>
        <span class="hero__line hero__line--2">Bjerre</span>
        <span class="hero__line hero__line--3">Knudsen</span>
      </h1>
      <div class="hero__intro" data-callouts>
        <div class="hero__dots" role="tablist" aria-label={c.callouts.label}>
          {
            c.callouts.items.map((_, i) => (
              <button
                type="button"
                class={`hero__dot${i === 0 ? ' is-active' : ''}`}
                data-callout-dot
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`${slideWord} ${i + 1}`}
              />
            ))
          }
        </div>
        <div class="hero__intro-viewport">
          {
            c.callouts.items.map((item, i) => (
              <p
                class={`hero__callout${i === 0 ? ' is-active' : ''}`}
                data-callout-slide
              >
                {item.text}
              </p>
            ))
          }
        </div>
      </div>
      <a class="btn btn--compact hero__cta" href="#contact">
        {c.speaking.label}
        <span class="btn__arrow" aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero__photo" data-hero-photo>
      {
        heroSlides.map((slide, i) => (
          <Image
            class={`hero__slide ${slide.mod}${i === 0 ? ' is-active' : ''}`}
            data-hero-slide
            src={slide.src}
            alt={slide.alt}
            widths={[400, 600, 900]}
            sizes="(max-width: 720px) 100vw, 600px"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        ))
      }
    </div>
  </div>
</section>

<!-- About -->
<section id="about">
  <div class="container" data-reveal>
    <p class="eyebrow">{c.about.label}</p>
    <div class="about__grid">
      <div class="about__main">
        <h2 class="h2">{c.about.heading}</h2>
        {c.about.body.map((para) => <p>{para}</p>)}
        <dl class="about__facts">
          {c.about.facts.map((fact) => (
            <div class="fact">
              <dt class="fact__value">{fact.value}</dt>
              <dd class="fact__label">{fact.label}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="about__photo">
        <Image
          src={lotteGrass}
          alt={aboutAlt}
          widths={[327, 420, 654, 840]}
          sizes="(max-width: 900px) 420px, 327px"
          data-lightbox
        />
      </div>
    </div>
  </div>
</section>

<!-- Mission -->
<section id="mission" class="section--cream">
  <div class="container" data-reveal>
    <p class="eyebrow">{c.mission.label}</p>
    <p class="statement">{c.mission.statement}</p>
  </div>
</section>

<!-- Awards & Media -->
<section id="awards">
  <div class="container" data-reveal>
    <p class="eyebrow">{awardsMediaLabel}</p>
    <div class="am__grid">
      <div id="media" class="am__col">
        <h2 class="h2" set:html={c.media.heading} />
        <div class="am__lists">
          {
            c.media.groups.map((group) => (
              <div class="entry-group">
                <p class="entry-group__head">{group.head}</p>
                <ul class="entries">
                  {group.items.map((item) => (
                    <Entry entry={item} />
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="am__col">
        <h2 class="h2">{c.recognition.heading}</h2>
        <div class="am__lists">
          {
            c.recognition.groups.map((group, gi) => (
              <div class:list={['entry-group', { 'entry-group--featured': gi === 0 }]}>
                <p class="entry-group__head">
                  {gi === 0 && <span class="oval" aria-hidden="true" />}
                  {group.head}
                </p>
                <ul class="entries">
                  {group.items.map((award, i) => (
                    <>
                      <Entry entry={award} />
                      {gi === 0 && i === 0 && (
                        <li class="entries__photo entries__photo--portrait">
                          <Image
                            src={lotteLaskerPrize}
                            alt={laskerPrizeAlt}
                            widths={[180, 360]}
                            sizes="180px"
                            data-lightbox
                          />
                        </li>
                      )}
                      {gi === 0 && i === 1 && (
                        <li class="entries__photo entries__photo--md">
                          <Image
                            src={breakthroughPrize}
                            alt={coupleAlt}
                            widths={[506, 1012]}
                            sizes="(max-width: 900px) 100vw, 506px"
                            data-lightbox
                          />
                        </li>
                      )}
                      {gi === 1 && i === 3 && (
                        <li class="entries__photo entries__photo--portrait">
                          <Image
                            src={lotteAmericanAcademy}
                            alt={americanAcademyAlt}
                            widths={[180, 360]}
                            sizes="180px"
                            data-lightbox
                          />
                        </li>
                      )}
                    </>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Work with Lotte (speaking + mentoring + contact) -->
<section id="contact" class="section--cream">
  <div class="container" data-reveal>
    <p class="eyebrow">{c.speaking.label}</p>

    <!-- Speaking — mirrors the About section's text + offset-photo grid -->
    <div class="work__grid">
      <div class="work__main">
        <h2 class="h2">{c.speaking.heading}</h2>
        <p class="work__lead">{c.speaking.lead}</p>
        <p>{c.speaking.body}</p>

        <div class="work__bullets">
          <p class="work__lead-in">{c.speaking.questionsIntro}</p>
          <ul class="bullets">
            {c.speaking.questions.map((q) => <li class="bullet">{q}</li>)}
          </ul>
        </div>
      </div>

      <div class="work__photo">
        <Image
          src={lottePortrait}
          alt={portraitAlt}
          widths={[327, 420, 654, 840]}
          sizes="(max-width: 900px) 420px, 327px"
          data-lightbox
        />
      </div>
    </div>

    <!-- Mentoring + contact — the Awards section's divider-and-head pattern -->
    <div class="work__row">
      <div class="work__cell">
        <h3 class="h2">{c.mentor.heading}</h3>
        <p>{c.mentor.body}</p>
        <ul class="bullets bullets--tight">
          {c.mentor.details.map((d) => <li class="bullet">{d}</li>)}
        </ul>
        <a class="work__link" href={mailtoMentor}>
          {c.mentor.ctaText}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="work__cell">
        <h3 class="h2">{c.contact.heading}</h3>
        <p>{c.contact.lead}</p>
        <a class="work__email" href={mailto}>{c.contact.email}</a>
        <a class="btn btn--compact work__cta" href={mailto}>
          {c.contact.ctaText}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function initReveal() {
    if (reduceMotion.matches) return;
    const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (!targets.length) return;
    document.documentElement.classList.add('has-reveal');
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          obs.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.1 });
    targets.forEach((el) => io.observe(el));
  }
  initReveal();

  // Hero — the portrait crossfade and the callout carousel run off one shared
  // clock, so the photo and the text always transition together as a pair.
  function initHero() {
    const photo = document.querySelector<HTMLElement>('[data-hero-photo]');
    const intro = document.querySelector<HTMLElement>('[data-callouts]');

    const slides = photo
      ? Array.from(photo.querySelectorAll<HTMLElement>('[data-hero-slide]'))
      : [];
    const texts = intro
      ? Array.from(intro.querySelectorAll<HTMLElement>('[data-callout-slide]'))
      : [];
    const dots = intro
      ? Array.from(intro.querySelectorAll<HTMLButtonElement>('[data-callout-dot]'))
      : [];

    const count = Math.max(slides.length, texts.length);
    if (count < 2) return;

    let current = 0;
    let timer = 0;

    const setActive = (els: HTMLElement[], i: number) => {
      els.forEach((el, n) => el.classList.toggle('is-active', n === i % els.length));
    };

    const show = (next: number) => {
      const target = ((next % count) + count) % count;
      if (target === current) return;
      current = target;
      setActive(slides, current);
      setActive(texts, current);
      dots.forEach((dot, n) => {
        const on = n === current % dots.length;
        dot.classList.toggle('is-active', on);
        dot.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };

    const start = () => {
      if (reduceMotion.matches) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 10000);
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      })
    );

    if (intro) {
      intro.addEventListener('mouseenter', stop);
      intro.addEventListener('mouseleave', start);
    }

    start();
  }

  initHero();

  // Lightbox — open any [data-lightbox] image in a modal dialog
  function initLightbox() {
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!lb) return;
    const lbImg = lb.querySelector<HTMLImageElement>('.lightbox__img');
    if (!lbImg) return;

    const getLargestSrc = (img: HTMLImageElement) => {
      if (!img.srcset) return img.src;
      const sources = img.srcset.split(',').map((s) => {
        const parts = s.trim().split(/\s+/);
        return { url: parts[0], width: parseInt(parts[1] ?? '0', 10) || 0 };
      });
      sources.sort((a, b) => b.width - a.width);
      return sources[0]?.url || img.src;
    };

    document.querySelectorAll<HTMLImageElement>('[data-lightbox]').forEach((img) => {
      img.setAttribute('role', 'button');
      img.setAttribute('tabindex', '0');
      img.setAttribute('aria-haspopup', 'dialog');

      const open = () => {
        lbImg.src = getLargestSrc(img);
        lbImg.alt = img.alt;
        lb.showModal();
      };

      img.addEventListener('click', open);
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });

    lb.querySelector('.lightbox__close')?.addEventListener('click', () => lb.close());

    lb.addEventListener('click', (e) => {
      // Close when clicking the backdrop (the dialog element itself, not its children)
      if (e.target === lb) lb.close();
    });
  }

  initLightbox();
</script>

<!-- Lightbox dialog -->
<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
  <button class="lightbox__close" aria-label="Close image viewer">&#x2715;</button>
  <img class="lightbox__img" src="" alt="" />
</dialog>
