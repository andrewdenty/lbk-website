---
import { Image } from 'astro:assets';
import lotteLab from '../assets/lotte-bjerre-knudsen-lab.webp';
import lotteGreen from '../assets/lotte-bjerre-knudsen-greenbg.webp';
import lotteGrass from '../assets/lotte-bjerre-knudsen-grass.webp';
import breakthroughPrize from '../assets/lotte-breakthrough-prize.webp';
import lottePortrait from '../assets/lotte-portrait.webp';
import { content, type Locale } from '../data/content';
import Entry from './Entry.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = content[lang];
const isDa = lang === 'da';

// Hero crossfade rotation — the lab portrait loads first, then the studio
// green-wall shot, crossfading back and forth every 10 seconds.
const heroSlides = [
  {
    src: lotteLab,
    mod: 'hero__slide--lab',
    alt: isDa
      ? 'Lotte Bjerre Knudsen i laboratoriet'
      : 'Lotte Bjerre Knudsen in the laboratory',
  },
  {
    src: lotteGreen,
    mod: 'hero__slide--green',
    alt: isDa
      ? 'Lotte Bjerre Knudsen fotograferet mod en grøn baggrund'
      : 'Lotte Bjerre Knudsen photographed against a green backdrop',
  },
];

const slideWord = isDa ? 'Udsagn' : 'Statement';
const coupleAlt = isDa
  ? 'Lotte Bjerre Knudsen ved Breakthrough Prize-ceremonien'
  : 'Lotte Bjerre Knudsen at the Breakthrough Prize ceremony';
const portraitAlt = isDa
  ? 'Portræt af Lotte Bjerre Knudsen'
  : 'Portrait of Lotte Bjerre Knudsen';
const aboutAlt = isDa
  ? 'Lotte Bjerre Knudsen i lyserødt jakkesæt blandt høje græsser'
  : 'Lotte Bjerre Knudsen in a pink suit among tall grasses';

const mailto = `mailto:${c.contact.email}`;
const awardsMediaLabel = `${c.recognition.label} & ${c.media.label}`;
const contactLabel = `${c.contact.label} Lotte:`;
---

<!-- Hero -->
<section class="hero">
  <div class="hero__inner container">
    <div class="hero__text">
      <h1 class="hero__wordmark">
        <span class="hero__line">Lotte</span>
        <span class="hero__line hero__line--2">Bjerre</span>
        <span class="hero__line hero__line--3">Knudsen</span>
      </h1>
      <div class="hero__tagline">
        {
          c.hero.taglineRows.map((row) => (
            <p class="tagline-row">
              {row.map((seg, i) => (
                <>
                  {i > 0 && <span class="oval" aria-hidden="true" />}
                  <span>{seg}</span>
                </>
              ))}
            </p>
          ))
        }
      </div>
    </div>
    <div class="hero__photo" data-hero-photo>
      {
        heroSlides.map((slide, i) => (
          <Image
            class={`hero__slide ${slide.mod}${i === 0 ? ' is-active' : ''}`}
            data-hero-slide
            src={slide.src}
            alt={slide.alt}
            widths={[400, 600, 900]}
            sizes="(max-width: 720px) 100vw, 600px"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        ))
      }
    </div>
  </div>
</section>

<!-- Intro callouts (carousel) -->
<section id="intro" class="callouts">
  <div class="container">
    <div class="callouts__carousel" data-callouts>
      <div class="callouts__dots" role="tablist" aria-label={c.callouts.label}>
        {
          c.callouts.items.map((_, i) => (
            <button
              type="button"
              class={`callouts__dot${i === 0 ? ' is-active' : ''}`}
              data-callout-dot
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`${slideWord} ${i + 1}`}
            />
          ))
        }
      </div>
      <div class="callouts__body">
        <div class="callouts__viewport">
          {
            c.callouts.items.map((item, i) => (
              <blockquote
                class={`callout${i === 0 ? ' is-active' : ''}`}
                data-callout-slide
              >
                <p class="statement callout__text">{item.text}</p>
              </blockquote>
            ))
          }
        </div>
        <a class="btn callouts__cta" href="#contact">
          {c.speaking.label}
          <span class="btn__arrow btn__arrow--down" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- About -->
<section id="about" class="section--cream">
  <div class="container">
    <p class="eyebrow">{c.about.label}</p>
    <div class="about__grid">
      <div class="about__main">
        <h2 class="h2">{c.about.heading}</h2>
        {c.about.body.map((para) => <p>{para}</p>)}
      </div>
      <div class="about__photo">
        <Image
          src={lotteGrass}
          alt={aboutAlt}
          widths={[327, 420, 654, 840]}
          sizes="(max-width: 900px) 420px, 327px"
        />
      </div>
    </div>
  </div>
</section>

<!-- Mission -->
<section id="mission">
  <div class="container">
    <p class="eyebrow">{c.mission.label}</p>
    <p class="statement">{c.mission.statement}</p>
  </div>
</section>

<!-- Awards & Media -->
<section id="awards" class="section--cream">
  <div class="container">
    <p class="eyebrow">{awardsMediaLabel}</p>
    <div class="am__grid">
      <div id="media" class="am__col">
        <h2 class="h2" set:html={c.media.heading} />
        <div class="am__lists">
          {
            c.media.groups.map((group) => (
              <div class="entry-group">
                <p class="entry-group__head">{group.head}</p>
                <ul class="entries">
                  {group.items.map((item) => (
                    <Entry entry={item} />
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="am__col">
        <h2 class="h2">{c.recognition.heading}</h2>
        <div class="am__lists">
          {
            c.recognition.groups.map((group, gi) => (
              <div class:list={['entry-group', { 'entry-group--featured': gi === 0 }]}>
                <p class="entry-group__head">
                  {gi === 0 && <span class="oval" aria-hidden="true" />}
                  {group.head}
                </p>
                <ul class="entries">
                  {group.items.map((award, i) => (
                    <>
                      <Entry entry={award} />
                      {gi === 0 && i === 1 && (
                        <li class="entries__photo">
                          <Image
                            src={breakthroughPrize}
                            alt={coupleAlt}
                            widths={[506, 1012]}
                            sizes="(max-width: 900px) 100vw, 506px"
                          />
                        </li>
                      )}
                    </>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Work with Lotte (speaking + contact) -->
<section id="contact">
  <div class="container">
    <p class="eyebrow">{c.speaking.label}</p>
    <div class="speak__grid">
      <div class="speak__main">
        <h2 class="h2">{c.speaking.heading}</h2>
        <p>{c.speaking.lead}</p>
        <p>{c.speaking.body}</p>

        <div class="speak__bullets">
          <p class="speak__lead-in">{c.speaking.questionsIntro}</p>
          <ul class="bullets">
            {c.speaking.questions.map((q) => <li class="bullet">{q}</li>)}
          </ul>
        </div>

        <div class="speak__contact">
          <p class="speak__contact-label">{contactLabel}</p>
          <a class="btn" href={mailto}>
            {c.contact.email}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="speak__photo">
        <Image
          src={lottePortrait}
          alt={portraitAlt}
          widths={[327, 420, 654, 840]}
          sizes="(max-width: 900px) 420px, 327px"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Hero — crossfade between the rotating portraits every 10 seconds.
  function initHeroRotation() {
    const stage = document.querySelector<HTMLElement>('[data-hero-photo]');
    if (!stage) return;
    const slides = Array.from(
      stage.querySelectorAll<HTMLElement>('[data-hero-slide]')
    );
    if (slides.length < 2 || reduceMotion.matches) return;

    let current = 0;
    window.setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 10000);
  }

  // Intro callouts — a minimal crossfade carousel with oval indicators.
  function initCallouts() {
    const root = document.querySelector<HTMLElement>('[data-callouts]');
    if (!root) return;
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('[data-callout-slide]')
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-callout-dot]')
    );
    if (slides.length < 2) return;

    let current = 0;
    let timer = 0;

    const show = (next: number) => {
      const target = (next + slides.length) % slides.length;
      if (target === current) return;
      slides[current].classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      dots[current]?.setAttribute('aria-selected', 'false');
      current = target;
      slides[current].classList.add('is-active');
      dots[current]?.classList.add('is-active');
      dots[current]?.setAttribute('aria-selected', 'true');
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };

    const start = () => {
      if (reduceMotion.matches) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 8000);
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      })
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
  }

  initHeroRotation();
  initCallouts();
</script>
