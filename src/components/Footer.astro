---
import type { NavItem } from '../data/content';

interface Props {
  links: NavItem[];
}

const { links } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container container--wide">
    <div class="footer__top">
      <p class="footer__wordmark">
        <span class="footer__line">Lotte</span>
        <span class="footer__line footer__line--2">Bjerre</span>
        <span class="footer__line footer__line--3">Knudsen</span>
      </p>

      <nav class="footer__nav" aria-label="Footer">
        <span class="oval oval--lg" aria-hidden="true"></span>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="footer__copy">© {year} Lotte Bjerre Knudsen</p>
  </div>
</footer>
