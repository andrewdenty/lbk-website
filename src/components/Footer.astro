---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <p class="footer__name">Lotte Bjerre Knudsen</p>
    <p class="footer__meta">
      Chief Scientific Advisor, Novo Nordisk · © {year}
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--bg);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .footer__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    margin: 0;
  }

  .footer__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: rgba(255, 212, 222, 0.7);
    margin: 0;
  }
</style>
