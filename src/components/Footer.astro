---
import type { Credit, NavItem } from '../data/content';

interface Props {
  links: NavItem[];
  credits: Credit[];
}

const { links, credits } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container container--wide">
    <div class="footer__top">
      <p class="footer__wordmark">
        <span class="footer__line">Lotte</span>
        <span class="footer__line footer__line--2">Bjerre</span>
        <span class="footer__line footer__line--3">Knudsen</span>
      </p>

      <nav class="footer__nav" aria-label="Footer">
        <span class="oval oval--lg" aria-hidden="true"></span>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">© {year} Lotte Bjerre Knudsen</p>
      <p class="footer__credits">
        {
          credits.map((credit) => (
            <span class="footer__credit">
              {credit.prefix}{' '}
              <a href={credit.href} target="_blank" rel="noopener">
                {credit.label}
              </a>
            </span>
          ))
        }
      </p>
    </div>
  </div>
</footer>
