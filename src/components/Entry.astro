---
import type { Entry } from '../data/content';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
---

<li class="entry">
  <div class="entry__head">
    <span class="entry__title">{entry.title}</span>
    {
      entry.year ? (
        <span class="entry__year">{entry.year}</span>
      ) : entry.tag ? (
        <span class="entry__tag">{entry.tag}</span>
      ) : null
    }
  </div>
  {entry.meta && <p class="entry__sub">{entry.meta}</p>}
  {
    entry.links && entry.links.length > 0 && (
      <div class="entry__links">
        {entry.links.map((link) => (
          <a class="entry__link" href={link.href} target="_blank" rel="noopener">
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</li>
