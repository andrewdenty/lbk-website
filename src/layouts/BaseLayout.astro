---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { content, type Locale } from '../data/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = content[lang];

const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enHref = `${base}/`;
const daHref = `${base}/da/`;
---

<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />

    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />

    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="da" href={daHref} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:locale" content={lang === 'da' ? 'da_DK' : 'en'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav lang={lang} links={c.nav} langAria={c.langAria} />
    <main id="top">
      <slot />
    </main>
    <Footer links={c.nav} />
  </body>
</html>
