---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import lottePortrait from '../assets/lotte-bjerre-knudsen-lab.webp';

const milestones = [
  { label: 'Joined Novo Nordisk', detail: '1989' },
  { label: 'Victoza (liraglutide) approved', detail: '2010' },
  { label: 'Ozempic (semaglutide) approved', detail: '2017' },
  { label: 'Wegovy (semaglutide) approved', detail: '2021' },
];

const education = [
  { label: 'Chemical Engineering, Technical University of Denmark', detail: '' },
  { label: 'DMSc, University of Copenhagen', detail: '2014' },
  { label: 'Adjunct Professor, Aarhus University', detail: '2015–2020' },
];

const publications = [
  {
    title:
      'Potent derivatives of glucagon-like peptide-1 with pharmacokinetic properties suitable for once-daily administration',
    sub: 'Knudsen LB, et al.',
    venue: 'Journal of Medicinal Chemistry',
    year: '2000',
  },
  {
    title: 'Discovery of the once-weekly GLP-1 analogue semaglutide',
    sub: 'Lau J, … Knudsen LB, et al.',
    venue: 'Journal of Medicinal Chemistry',
    year: '2015',
  },
  {
    title: 'The discovery and development of liraglutide and semaglutide',
    sub: 'Knudsen LB, Lau J',
    venue: 'Frontiers in Endocrinology',
    year: '2019',
  },
];

const awards = [
  {
    year: '2025',
    title: 'Breakthrough Prize in Life Sciences',
    sub: 'Breakthrough Prize Foundation',
  },
  {
    year: '2024',
    title: 'Lasker~DeBakey Clinical Medical Research Award',
    sub: 'Lasker Foundation · shared with Svetlana Mojsov and Joel Habener',
  },
  {
    year: '2024',
    title: 'Mani L. Bhaumik Breakthrough of the Year Award',
    sub: 'American Association for the Advancement of Science (AAAS)',
  },
  {
    year: '2024',
    title: 'Golden Plate Award',
    sub: 'American Academy of Achievement',
  },
  {
    year: '2023',
    title: 'Paul Langerhans Medal',
    sub: 'German Diabetes Society (DDG)',
  },
  {
    year: '2023',
    title: 'STAT Biomedical Innovation Award',
    sub: 'STAT',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-stage">
      <div class="hero-photo">
        <Image
          src={lottePortrait}
          alt="Lotte Bjerre Knudsen in the laboratory"
          widths={[500, 750, 1100]}
          sizes="(max-width: 760px) 100vw, 48vw"
          loading="eager"
        />
      </div>
      <div class="hero-lead">
        <h1 class="wordmark">
          <span class="wordmark__line wordmark__line--1">Lotte</span>
          <span class="wordmark__line wordmark__line--2">Bjerre</span>
          <span class="wordmark__line wordmark__line--3">Knudsen</span>
        </h1>
        <p class="hero-tagline">
          <span class="hero-tagline__row">
            Life Sciences Innovator <span class="sep" aria-hidden="true">•</span> Inventor
          </span>
          <span class="hero-tagline__row">
            Key Opinion Leader <span class="sep" aria-hidden="true">•</span> Key Note Speaker
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="container">
      <div class="grid">
        <div class="col-label">About</div>
        <div class="col-body">
          <h2>Three decades at the frontier of metabolic science</h2>
          <p class="lead">
            I joined Novo Nordisk in 1989 as a student, initially working on
            enzymes used in laundry detergents. I moved into diabetes research
            soon after, and spent the next three decades on a class of molecules
            called GLP-1 receptor agonists.
          </p>
          <p>
            I led the team that developed liraglutide, which was approved as
            Victoza in 2010, and oversaw the development of semaglutide, which
            became Ozempic in 2017 and Wegovy in 2021. The work began as a search
            for a better diabetes drug and ended up changing how obesity is
            treated.
          </p>
          <p>
            I hold a DMSc from the University of Copenhagen and was adjunct
            professor in translational medicine at Aarhus University from 2015 to
            2020. I left Novo Nordisk in May 2026.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Career -->
  <section id="career">
    <div class="container">
      <div class="grid">
        <div class="col-label">Career</div>
        <div class="col-body">
          <h2>From enzymes to a new class of medicine</h2>
          <p class="lead">
            My career followed a single family of molecules further than almost
            anyone in the field — from early target biology through to medicines
            now used by millions of people worldwide.
          </p>
          <p>
            What began as fundamental research into how the gut signals to the
            brain became liraglutide and then semaglutide: compounds that
            reshaped the standard of care in both type 2 diabetes and obesity.
          </p>

          <div class="two-col">
            <div>
              <div class="list-head">Milestones</div>
              <ul class="facts">
                {
                  milestones.map((m) => (
                    <li>
                      <span class="label">{m.label}</span>
                      <span class="detail">{m.detail}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <div class="list-head">Education</div>
              <ul class="facts">
                {
                  education.map((e) => (
                    <li>
                      <span class="label">{e.label}</span>
                      <span class="detail">{e.detail}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Publications -->
  <section id="publications">
    <div class="container">
      <div class="grid">
        <div class="col-label">Publications</div>
        <div class="col-body">
          <h2>Selected publications</h2>
          <ul class="entries">
            {
              publications.map((p) => (
                <li class="entry">
                  <div>
                    <div class="entry__title">{p.title}</div>
                    <div class="entry__sub">{p.sub}</div>
                  </div>
                  <div class="entry__meta">
                    <span class="year">{p.year}</span>
                    {p.venue}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Recognition -->
  <section id="recognition">
    <div class="container">
      <div class="grid">
        <div class="col-label">Recognition</div>
        <div class="col-body">
          <h2>Honoured across medicine and science</h2>
          <ul class="entries">
            {
              awards.map((a) => (
                <li class="entry">
                  <div>
                    <div class="entry__title">{a.title}</div>
                    <div class="entry__sub">{a.sub}</div>
                  </div>
                  <div class="entry__meta">
                    <span class="year">{a.year}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact">
    <div class="container">
      <div class="grid">
        <div class="col-label">Contact</div>
        <div class="col-body">
          <h2>Get in touch</h2>
          <p class="lead">For speaking, advisory, and research enquiries.</p>
          <ul class="contact-links">
            <li><a href="mailto:hello@lottebjerreknudsen.com">Email</a></li>
            <li><a href="https://www.linkedin.com/" rel="noopener">LinkedIn</a></li>
            <li><a href="https://orcid.org/" rel="noopener">ORCID</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
